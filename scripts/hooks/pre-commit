#!/usr/bin/env bash
# sg-skills pre-commit：commit 前自動跑 repository 契約與 Claude plugin validate。
# 掛法：git config core.hooksPath scripts/hooks（重 clone 後跑一次）。
set -euo pipefail

echo "[pre-commit] 連結檢查…"
python3 scripts/check-links.py

echo "[pre-commit] 雙平台 plugin 相容檢查…"
python3 scripts/check-plugin-compat.py

echo "[pre-commit] UI workflow 契約檢查…"
python3 scripts/check-ui-workflows.py

echo "[pre-commit] 完整遊戲交付 workflow 契約檢查…"
python3 scripts/check-game-delivery-workflow.py

if command -v claude >/dev/null 2>&1; then
  echo "[pre-commit] Claude plugin validate…"
  claude plugin validate .
  echo "[pre-commit] 全部通過 ✔"
else
  echo "[pre-commit] repository 檢查通過；未執行 Claude validate（PATH 找不到 claude CLI）"
fi
